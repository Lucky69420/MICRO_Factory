{
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright": "1.64.0",
    "prettier": "3.9.10"
  },
  "name": "micro-factory",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "test": "node scripts/test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:files": "node scripts/check-file-lengths.js",
    "check": "npm run lint && npm run format:check && npm run check:files && npm test && npm run build",
    "test:browser": "node scripts/browser-smoke.js",
    "bench": "node --experimental-vm-modules tests/performance.cjs"
  }
}
